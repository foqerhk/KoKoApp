    "Relay" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中继" } } } },
    "Quick Setup on Server" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快捷设置到服务器" } } } },
    "Choose which SSH host should receive this public key." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择要把公钥安装到哪台 SSH 主机。" } } } },
    "Install Public Key" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装公钥" } } } },
    "Connecting to server…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在连接服务器…" } } } },
    "Authenticating…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在认证…" } } } },
    "Writing authorized_keys…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在写入 authorized_keys…" } } } },
    "Enabling public-key login on server…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在开启服务器公钥登录…" } } } },
    "Could not enable public-key login on the server" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法开启服务器公钥登录" } } } },
    "Need sudo (password) to turn on PubkeyAuthentication in sshd_config" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要 sudo 密码才能在 sshd_config 中开启 PubkeyAuthentication" } } } },
    "sudo failed while enabling PubkeyAuthentication. Check the account can use sudo." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用 sudo 开启 PubkeyAuthentication 失败，请确认该账号有 sudo 权限。" } } } },
    "sshd still reports PubkeyAuthentication no after reload" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "reload 之后 sshd 仍报告 PubkeyAuthentication no" } } } },
    "Switching host to key login…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在切换为主机密钥登录…" } } } },
    "Public key installed" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公钥已安装" } } } },
    "This host now uses key login. The saved password was removed from KoKo." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该主机已改为密钥登录，KoKo 中保存的密码已清除。" } } } },
    "Done" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成" } } } },
    "Cancelled" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已取消" } } } },
    "Only SSH hosts support public key install" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅 SSH 主机支持安装公钥" } } } },
    "Host has no password or usable key to connect with first" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机尚无密码或其他可用密钥，无法先登录安装" } } } },
    "Server did not confirm key install" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器未确认公钥安装成功" } } } },
    "Confirm host fingerprint to continue…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请确认主机指纹以继续…" } } } },
    "Setup complete" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置完成" } } } },
    "Setup failed" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置失败" } } } },
    "Setup succeeded" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置成功" } } } },
    "Public key is on the server. This host now uses key login in KoKo; the saved password was removed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公钥已写入服务器。该主机已在 KoKo 中改为密钥登录，并已清除保存的密码。" } } } },
    "After you trust it, KoKo will finish installing the public key and switch this host to key login." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "信任后，KoKo 会继续安装公钥，并把该主机切换为密钥登录。" } } } },
    "Host key was rejected" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已拒绝主机指纹" } } } },
    "Delete Key" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除密钥" } } } },
    "Delete Key?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除密钥？" } } } },
    "Delete %@ from this device? The private key will be removed from Keychain and cannot be recovered." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要从本机删除“%@”吗？私钥将从 Keychain 移除且无法恢复。" } } } },
    "Delete the selected keys from this device? Private keys will be removed from Keychain and cannot be recovered." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要删除选中的密钥吗？私钥将从 Keychain 移除且无法恢复。" } } } },
    "Delete in %llds" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 秒后可删除" } } } },
    "Pre-filled — change only if you want." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已自动填写，无需改也可直接保存。" } } } },
    "SSH authentication failed. Check username / key / password. If you switched to key login, re-run Quick Setup on Server or restore password auth." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SSH 认证失败。请检查用户名 / 密钥 / 密码。若刚改成密钥登录，请重新「快捷设置到服务器」，或暂时改回密码登录。" } } } },
    "SSH channel could not be opened. Try Reconnect." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法打开 SSH 通道，请点重新连接。" } } } },
    "Server rejected password authentication." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器拒绝了密码认证。" } } } },
    "Server rejected key authentication." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器拒绝了密钥认证。" } } } },
    "Server disabled public-key login (PubkeyAuthentication no). Ask the admin to enable it in sshd_config, then retry." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器关闭了公钥登录（PubkeyAuthentication no）。请在 sshd_config 中开启后再试。" } } } },
    "Server rejected host-based authentication." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器拒绝了基于主机的认证。" } } } },
    "SSH authentication failed. Check username / key / password." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "SSH 认证失败。请检查用户名 / 密钥 / 密码。" } } } },
    "Delete Host" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除主机" } } } },
    "Delete Host?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除主机？" } } } },
    "Delete %@? Related sessions on this device will also be removed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要删除“%@”吗？本机上的相关会话也会被移除。" } } } },
    "Delete the selected hosts? Related sessions on this device will also be removed." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要删除选中的主机吗？本机上的相关会话也会被移除。" } } } },
    "Delete Session" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除会话" } } } },
    "Delete Session?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除会话？" } } } },
    "Delete %@ from this device? The remote tmux / agent is not terminated." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要从本机删除“%@”吗？远端 agent persist 不会被终止。" } } } },
    "Verifying key login…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在验证密钥登录…" } } } },
    "Public key was written, but key login still failed. Password login was kept." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公钥已写入，但密钥登录仍失败，已保留密码登录。" } } } },
    "Public key was written, but key login still failed: %@. Password login was kept." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公钥已写入，但密钥登录仍失败：%@。已保留密码登录。" } } } },
    "Could not resolve remote home directory" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法解析远端用户主目录" } } } },
    "Checking/installing Node.js/npm on server…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查/安装服务器上的 Node.js/npm…" } } } },
    "Checking server outbound network…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检测服务器出网…" } } } },
    "Could not install Node.js/npm on the server" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法在服务器上安装 Node.js/npm" } } } },
    "Server outbound network is restricted — cannot reach %@ install sources. Configure an HTTP/HTTPS proxy on the server, or install the CLI manually on a machine with internet access." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器出网受限，无法访问 %@ 的安装源。请在服务器上配置 HTTP/HTTPS 代理，或在可联网的机器上手动安装 CLI 后同步到服务器。" } } } },
    "%@ CLI install did not finish successfully on the server" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器上 %@ CLI 安装未成功完成" } } } },
    "Generated public key is invalid" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "生成的公钥无效" } } } },
    "Remote command failed (exit %lld)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "远端命令失败（退出码 %lld）" } } } },
    "Server install command failed (exit %lld)" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器安装命令失败（退出码 %lld）" } } } }
  },
  "version" : "1.0"
}
