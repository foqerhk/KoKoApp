    "Private keys stay in Keychain on this device. Add the public key to the server’s authorized_keys." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "私钥仅保存在本机 Keychain；请将公钥写入服务器 authorized_keys。" } } } },
