    "Starts a new Agent conversation in this project directory. Existing chats appear after refresh." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在该项目目录启动新的 Agent 对话。已有对话刷新后会出现在列表中。" } } } },
    "Add a host and project path first" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先添加主机和项目路径" } } } },
    "Only SSH hosts support syncing agent conversations" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅 SSH 主机支持同步 Agent 对话" } } } },
    "Could not parse agent conversation list from server" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法解析服务器返回的 Agent 对话列表" } } } },
    "Could not parse agent session list from server" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法解析服务器返回的 Agent 会话列表" } } } },
    "Remove %@ from this list? The Agent chat on the server is not deleted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从列表移除“%@”？服务器上的 Agent 对话不会被删除。" } } } },
    "Delete %@ on the server and on this device? This cannot be undone." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除“%@”在服务器和本机上的会话？此操作不可撤销。" } } } },
    "Delete the selected conversations on the server and on this device? This cannot be undone." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除所选会话在服务器和本机上的记录？此操作不可撤销。" } } } },
