    "This ends the remote tmux / agent session — different from Disconnect." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这将结束远端 agent persist 会话，与「断开连接」不同。" } } } },
    "Confirm the server host key fingerprint" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "首次连接，请确认服务器主机指纹" } } } },
    "Connections are blocked if the fingerprint changes. Verify it with your server admin." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "指纹变化时将阻止连接。请与你服务器管理员提供的指纹核对。" } } } },
    "Host Fingerprint" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主机指纹" } } } },
