    "Version" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "版本" } } } },
    "Build time is stamped on each install so you can confirm the latest sync." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每次构建都会写入时间戳，便于确认是否为最新同步版本。" } } } },
    "Affects KoKo UI only. Terminal / agent output follows the remote session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅影响 KoKo 界面；终端 / Agent 输出仍跟随远端会话。" } } } },
    "Add an SSH server or pair a RunEverything agent" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加 SSH 主机，或配对 RunEverything Agent" } } } },
    "Add SSH Host" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加 SSH 主机" } } } },
    "Pair RunEverything" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配对 RunEverything" } } } },
    "Scan RunEverything QR" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描 RunEverything 二维码" } } } },
    "Scan QR Code" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描二维码" } } } },
    "Scan QR" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫码" } } } },
    "Point the camera at the QR from `runeverything pair`, or paste the JSON / koko:// link below." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对准 `runeverything pair` 显示的二维码，或在下方粘贴 JSON / koko:// 链接。" } } } },
    "Or Paste" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "或粘贴" } } } },
    "Pairing payload" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配对内容" } } } },
    "Pair" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "配对" } } } },
    "Camera Unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法使用相机" } } } },
    "QR scanning needs a device camera. On Simulator, paste the QR JSON instead." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫码需要真机相机。模拟器请粘贴二维码 JSON。" } } } },
    "Scanner Error" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫码错误" } } } },
