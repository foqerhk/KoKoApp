    "Trust the host key to continue deleting the remote session." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "信任主机指纹以继续删除远端会话。" } } } },
    "Remove the selected items from this list? Agent chats on the server are not deleted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从列表移除所选项目？服务器上的 Agent 对话不会被删除。" } } } },
